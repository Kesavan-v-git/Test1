<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Farm Crate — Checkout</title>

<style>
    :root {
        --paper: #f3eedd;
        --paper-dark: #e8dfc4;
        --forest: #1f3d2b;
        --forest-deep: #16291d;
        --kraft: #c98b3a;
        --tomato: #c1432e;
        --ink: #2a2118;
        --line: rgba(42,33,24,0.16);
        --display: Arial, sans-serif;
        --body: Georgia, serif;
        --mono: monospace;
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--body);
        min-height: 100vh;
    }

    .banner {
        background: var(--forest);
        color: var(--paper);
        padding: 34px 20px 30px;
        text-align: center;
        border-bottom: 6px solid var(--forest-deep);
    }

    .banner .stamp {
        display: inline-block;
        border: 3px solid var(--paper);
        border-radius: 6px;
        padding: 6px 18px;
    }

    .banner h1 {
        font-family: var(--display);
        font-size: 48px;
        margin: 0;
    }

    .tagline {
        font-family: var(--mono);
        font-size: 12px;
        margin-top: 10px;
        opacity: 0.7;
    }

    .layout {
        max-width: 1080px;
        margin: auto;
        padding: 32px 20px 60px;
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 28px;
    }

    @media (max-width: 800px) {
        .layout {
            grid-template-columns: 1fr;
        }
    }

    .section-label {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--forest);
        margin-bottom: 14px;
    }

    .produce-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 16px;
    }

    .produce {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 16px 12px;
        text-align: center;
        cursor: pointer;
        position: relative;
    }

    .produce:hover {
        border-color: var(--forest);
        transform: translateY(-2px);
    }

    .sticker {
        width: 64px;
        height: 64px;
        margin: auto auto 10px;
        border-radius: 50%;
        background: var(--paper-dark);
        border: 2px dashed rgba(42,33,24,0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }

    .produce .name {
        font-weight: bold;
        font-size: 15px;
    }

    .produce .price {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--forest);
        margin-top: 4px;
    }

    .qty-badge {
        position: absolute;
        top: -8px;
        left: -8px;
        background: var(--tomato);
        color: white;
        min-width: 22px;
        height: 22px;
        border-radius: 50%;
        display: none;
        align-items: center;
        justify-content: center;
        font-family: var(--mono);
    }

    .produce.in-cart .qty-badge {
        display: flex;
    }

    .crate {
        background: var(--forest);
        color: var(--paper);
        border-radius: 12px;
        padding: 20px;
        height: fit-content;
        position: sticky;
        top: 20px;
    }

    .crate h2 {
        margin: 0 0 4px;
    }

    .sub {
        font-family: var(--mono);
        font-size: 11px;
        opacity: 0.6;
        margin-bottom: 16px;
    }

    .cart-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 16px;
    }

    .cart-empty {
        font-family: var(--mono);
        font-size: 12px;
        opacity: 0.55;
        padding: 18px 0;
        text-align: center;
        border: 1px dashed rgba(243,238,221,0.25);
        border-radius: 8px;
    }

    .cart-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        font-size: 13px;
        background: rgba(243,238,221,0.06);
        border-radius: 7px;
        padding: 8px 10px;
    }

    .ci-name {
        flex: 1;
    }

    .ci-price {
        font-family: var(--mono);
        font-size: 12px;
    }

    .stepper {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: var(--mono);
    }

    .stepper button {
        width: 22px;
        height: 22px;
        border-radius: 4px;
        border: 1px solid rgba(243,238,221,0.35);
        background: transparent;
        color: white;
        cursor: pointer;
    }

    .crate-total {
        display: flex;
        justify-content: space-between;
        border-top: 1px solid rgba(243,238,221,0.2);
        padding-top: 14px;
        margin-bottom: 16px;
        font-family: var(--mono);
    }

    .checkout-btn {
        width: 100%;
        background: var(--tomato);
        color: var(--paper);
        border: none;
        border-radius: 8px;
        padding: 14px;
        font-weight: bold;
        font-size: 17px;
        cursor: pointer;
    }

    .checkout-btn:disabled {
        opacity: 0.6;
        cursor: wait;
    }

    .empty-hint {
        font-family: var(--mono);
        font-size: 11px;
        opacity: 0.55;
        text-align: center;
        margin-top: 10px;
    }

    .log-panel {
        grid-column: 1 / -1;
    }

    .log-box {
        background: var(--ink);
        color: #d9d2c0;
        border-radius: 10px;
        padding: 16px 18px;
        font-family: var(--mono);
        font-size: 12.5px;
        line-height: 1.7;
        white-space: pre-wrap;
        word-break: break-word;
        display: none;
    }

    .log-box.show {
        display: block;
    }

    .tag {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 10px;
        margin-right: 8px;
    }

    .tag.sent {
        background: #3a5240;
        color: #cdeed6;
    }

    .tag.ok {
        background: #2c4a34;
        color: #a9e6b8;
    }

    .tag.err {
        background: #4a2c28;
        color: #f3b3a9;
    }
</style>
</head>

<body>

<div class="banner">
    <div class="stamp">
        <h1>Farm Crate</h1>
    </div>

    <div class="tagline">
        Fresh Produce · Order Terminal
    </div>
</div>


<div class="layout">

    <!-- PRODUCE -->
    <div>

        <p class="section-label">
            Today's crate
        </p>

        <div
            class="produce-grid"
            id="produceGrid">
        </div>

    </div>


    <!-- CART -->
    <div class="crate">

        <h2>Your Crate</h2>

        <div
            class="sub"
            id="crateCount">
            0 items
        </div>

        <div
            class="cart-list"
            id="cartList">
        </div>

        <div class="crate-total">

            <span>Total</span>

            <span id="crateTotal">
                ₹0.00
            </span>

        </div>

        <button
            class="checkout-btn"
            id="checkoutBtn">

            Checkout

        </button>

        <div class="empty-hint">
            You can click Checkout with an empty crate
            to test the API error logging.
        </div>

    </div>


    <!-- LOG -->
    <div class="log-panel">

        <p class="section-label">
            Structured API log
        </p>

        <div
            class="log-box"
            id="logBox">
        </div>

    </div>

</div>


<script>
const API_URL = "http://127.0.0.1:8002/api/order/total";

const PRODUCE = [
    { id: "apple", name: "Apple", icon: "🍎", price: 55.25 },
    { id: "banana", name: "Banana", icon: "🍌", price: 29.75 },
    { id: "orange", name: "Orange", icon: "🍊", price: 59.50 },
    { id: "grapes", name: "Grapes", icon: "🍇", price: 204.00 },
    { id: "strawberry", name: "Strawberry", icon: "🍓", price: 263.50 },
    { id: "tomato", name: "Tomato", icon: "🍅", price: 76.50 },
    { id: "carrot", name: "Carrot", icon: "🥕", price: 42.50 },
    { id: "broccoli", name: "Broccoli", icon: "🥦", price: 136.00 },
    { id: "potato", name: "Potato", icon: "🥔", price: 38.25 },
    { id: "spinach", name: "Spinach", icon: "🥬", price: 178.50 },
    { id: "pepper", name: "Bell Pepper", icon: "🫑", price: 80.75 },
    { id: "cucumber", name: "Cucumber", icon: "🥒", price: 51.00 }
];

let cart = {};


/* -----------------------------------------
   DISPLAY PRODUCE
----------------------------------------- */

function renderGrid() {

    const grid = document.getElementById("produceGrid");

    grid.innerHTML = PRODUCE.map(product => `
        <div
            class="produce ${cart[product.id] ? "in-cart" : ""}"
            data-id="${product.id}"
        >

            <div class="qty-badge">
                ${cart[product.id] || ""}
            </div>

            <div class="sticker">
                ${product.icon}
            </div>

            <div class="name">
                ${product.name}
            </div>

            <div class="price">
                ₹${product.price.toFixed(2)}
            </div>

        </div>
    `).join("");


    grid.querySelectorAll(".produce").forEach(card => {

        card.addEventListener("click", () => {

            const id = card.dataset.id;

            cart[id] = (cart[id] || 0) + 1;

            renderGrid();
            renderCart();

        });

    });

}


/* -----------------------------------------
   DISPLAY CART
----------------------------------------- */

function renderCart() {

    const list = document.getElementById("cartList");

    const ids = Object.keys(cart)
        .filter(id => cart[id] > 0);


    if (ids.length === 0) {

        list.innerHTML = `
            <div class="cart-empty">
                Crate's empty — tap produce to add it.
            </div>
        `;

    } else {

        list.innerHTML = ids.map(id => {

            const product =
                PRODUCE.find(p => p.id === id);

            return `
                <div class="cart-item">

                    <span class="ci-name">
                        ${product.icon}
                        ${product.name}
                    </span>

                    <div class="stepper">

                        <button
                            data-id="${id}"
                            data-op="-"
                        >
                            −
                        </button>

                        <span>
                            ${cart[id]}
                        </span>

                        <button
                            data-id="${id}"
                            data-op="+"
                        >
                            +
                        </button>

                    </div>

                    <span class="ci-price">
                        ₹${(product.price * cart[id]).toFixed(2)}
                    </span>

                </div>
            `;

        }).join("");


        list.querySelectorAll(".stepper button")
            .forEach(button => {

                button.addEventListener("click", event => {

                    event.stopPropagation();

                    const id = button.dataset.id;
                    const operation = button.dataset.op;


                    if (operation === "+") {

                        cart[id] += 1;

                    } else {

                        cart[id] -= 1;

                        if (cart[id] <= 0) {
                            delete cart[id];
                        }

                    }

                    renderGrid();
                    renderCart();

                });

            });

    }


    const totalItems =
        ids.reduce(
            (sum, id) => sum + cart[id],
            0
        );


    const totalPrice =
        ids.reduce((sum, id) => {

            const product =
                PRODUCE.find(p => p.id === id);

            return sum +
                product.price * cart[id];

        }, 0);


    document.getElementById("crateCount")
        .textContent =
        `${totalItems} item${totalItems === 1 ? "" : "s"}`;


    document.getElementById("crateTotal")
        .textContent =
        `₹${totalPrice.toFixed(2)}`;

}


/* -----------------------------------------
   CREATE ORDER
----------------------------------------- */

function buildOrderPayload() {

    const items = [];


    Object.keys(cart).forEach(id => {

        if (cart[id] > 0) {

            const product =
                PRODUCE.find(p => p.id === id);

            items.push({

                name: product.name,

                quantity: cart[id],

                price: product.price

            });

        }

    });


    return {
        items: items
    };

}


/* -----------------------------------------
   CHECKOUT
----------------------------------------- */

async function checkout() {

    const button =
        document.getElementById("checkoutBtn");

    const logBox =
        document.getElementById("logBox");


    const payload =
        buildOrderPayload();


    console.log(
        "Checkout clicked"
    );

    console.log(
        "Sending payload:",
        payload
    );


    /*
       IMPORTANT:

       We DO NOT stop when the cart is empty.

       We send:

       {
           "items": []
       }

       to the backend.

       Your Python backend then executes:

       average = total / len(order.items)

       0 / 0

       which creates the error that TraceFix should capture.
    */


    button.disabled = true;

    button.textContent =
        "Sending...";


    logBox.classList.add("show");


    const requestText =
        `POST ${API_URL}\n\n` +
        JSON.stringify(
            payload,
            null,
            2
        );


    logBox.innerHTML =
        `<span class="tag sent">REQUEST</span>\n` +
        escapeHtml(requestText);


    try {

        console.log(
            "Sending request to:",
            API_URL
        );


        const response =
            await fetch(
                API_URL,
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify(payload)
                }
            );


        console.log(
            "Backend HTTP status:",
            response.status
        );


        const data =
            await response.json()
                .catch(() => ({}));


        console.log(
            "Backend response:",
            data
        );


        const responseText =
            `HTTP ${response.status}\n\n` +
            JSON.stringify(
                data,
                null,
                2
            );


        if (response.status >= 500) {

            logBox.innerHTML =

                `<span class="tag sent">REQUEST</span>\n` +

                escapeHtml(requestText) +

                `\n\n` +

                `<span class="tag err">500 ERROR</span>\n` +

                escapeHtml(responseText) +

                `\n\n` +

                `<span class="tag ok">BACKEND CRASH</span>\n` +

                `The backend crashed while processing the empty order.`;

            console.error(
                "Backend returned 500:",
                data
            );

        } else {

            logBox.innerHTML =

                `<span class="tag ok">SUCCESS</span>\n` +

                escapeHtml(responseText);

        }

    } catch (error) {

        console.error(
            "Fetch error:",
            error
        );


        logBox.innerHTML =

            `<span class="tag err">NETWORK ERROR</span>\n\n` +

            escapeHtml(
                error.message
            ) +

            `\n\n` +

            `Check that FastAPI is running on:\n` +

            `http://127.0.0.1:8002`;

    } finally {

        button.disabled = false;

        button.textContent =
            "Checkout";

    }

}


/* -----------------------------------------
   HTML ESCAPING
----------------------------------------- */

function escapeHtml(value) {

    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}


/* -----------------------------------------
   CONNECT CHECKOUT BUTTON
----------------------------------------- */

document
    .getElementById("checkoutBtn")
    .addEventListener(
        "click",
        checkout
    );


/* -----------------------------------------
   INITIAL DISPLAY
----------------------------------------- */

renderGrid();

renderCart();

</script>
</body>
</html>
